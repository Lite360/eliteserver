# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@ep-sample-12345.us-east-2.aws.neon.tech/neondb?sslmode=require

# Cryptographic Command & Response HMAC Signing Secret
COMMAND_SIGNING_SECRET=your_super_secret_signing_key_32_characters_minimum

# Vercel Blob Storage Token (For software release binaries)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_token_here

# Admin Authentication Secret (JWT)
JWT_SECRET=your_jwt_super_secret_key_here
